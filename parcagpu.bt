#!/usr/bin/env bpftrace

BEGIN {
    printf("Monitoring colagpu USDT probes: %s ...\n", $1);
    printf("%-20s %-12s %-10s %-10s %-10s %-10s %-10s %-10s %s\n",
           "TIME", "DURATION_NS", "CORR_ID", "DEVICE", "STREAM", "GRAPH", "NODE", "START", "KERNEL");
}

// ---------------------------------------------------------------------------
// api_correlation: fired on runtime-API EXIT for sampled launches.
//   arg0 = correlationId (u32)
//   arg1 = cbid          (int)  — backend callback id:
//          * CUPTI/NVIDIA: CUpti_CallbackId
//          * MSPTI/Ascend: msptiCallbackId (MSPTI_CBID_RUNTIME_*)
//   arg2 = name          (str)  — API name. MSPTI: "aclrtLaunchKernel",
//                                  "aclnnAdd", ...; CUPTI: "cuLaunchKernel", ...
// ---------------------------------------------------------------------------
usdt:$1:colagpu:api_correlation {
    $correlation_id = arg0;
    $cbid = arg1;
    $name = str(arg2);

    // MSPTI runtime CBIDs that parcagpu subscribes to (see mspti_cbid.h).
    // CUPTI runs use a different id space — there the raw cbid + $name are the
    // reliable identifiers and this name lookup is simply empty.
    $cbidName = ($cbid == 9)  ? "stream_synchronized" :
                (($cbid == 10) ? "launch" :
                (($cbid == 12) ? "aicpu_launch" :
                (($cbid == 13) ? "aiv_launch" :
                (($cbid == 14) ? "ffts_launch" :
                (($cbid == 22) ? "memcpy" :
                (($cbid == 24) ? "memcpy_async" : ""))))));

    printf("%-12s.%-6u [CORR] %u: cbid=%d %-20s %s\n",
           strftime("%H:%M:%S", nsecs), (nsecs % 1000000000) / 1000,
           $correlation_id, $cbid, $name, $cbidName);
}

// ---------------------------------------------------------------------------
// api_synchronize: fired on synchronize-API EXIT. syncKind is vendor-neutral
// and backend-partitioned: 100-199 = CUPTI (NVIDIA), 200-299 = MSPTI (Ascend).
// ---------------------------------------------------------------------------
usdt:$1:colagpu:api_synchronize {
    $start = arg0;
    $end = arg1;
    $kind = arg2;
    $dur_ns = $end - $start;
    $kindStr = ($kind == 100) ? "cuStreamSynchronize" :
               (($kind == 101) ? "cuCtxSynchronize" :
               (($kind == 102) ? "cuEventSynchronize" :
               (($kind == 103) ? "cuStreamSynchronize_ptsz" :
               (($kind == 200) ? "aclrtSynchronizeStream" : "unknown"))));

    printf("%-12s.%-6u [SYNC] kind=%u %s start=%lu end=%lu dur=%lu ns\n",
           strftime("%H:%M:%S", nsecs),
           (nsecs % 1000000000) / 1000,
           $kind, $kindStr, $start, $end, $dur_ns);
}

// ---------------------------------------------------------------------------
// error: fired when a runtime API returns a non-zero code (CUPTI + MSPTI).
//   arg0 = code      (int32)  — aclError (MSPTI) / cudaError (CUPTI)
//   arg1 = message   (str)    — e.g. "ACL_ERROR_RT_PARAM_INVALID"
//   arg2 = component (str)    — MSPTI: "api-<functionName>"; CUPTI: "api-<func>"
// ---------------------------------------------------------------------------
usdt:$1:colagpu:error {
    $code = arg0;
    $message = str(arg1);
    $component = str(arg2);

    printf("%-12s.%-6u [ERROR] code=%d %s (%s)\n",
           strftime("%H:%M:%S", nsecs),
           (nsecs % 1000000000) / 1000,
           $code, $message, $component);
}

usdt:$1:colagpu:host_timing {
    $ptrs = arg0;
    $count = arg1;

    printf("%-12s.%-6u [HOST_TIMING] count=%u\n",
           strftime("%H:%M:%S", nsecs),
           (nsecs % 1000000000) / 1000,
           $count);

    // Host-side timing (ACTIVITY_KIND_HOST_API = 2). Only kind/start/end/
    // correlationId are populated; the rest of ActivityEvent stays zeroed.
    //   +0:  kind (u64)
    //   +8:  start (u64)
    //  +16:  end (u64)
    //  +24:  correlationId (u32)
    $limit = $count;
    if ($limit > 128) {
        $limit = 128;
    }
    if ($limit > 0) {
        for ($i : 0..($limit - 1)) {
            $r = *(uint64 *)($ptrs + $i * 8);
            if ($r == 0) { continue; }
            $dur = (int64)(*(uint64 *)($r + 16)) - (int64)(*(uint64 *)($r + 8));
            printf("  [%d] HOSTAPI corr=%u dur=%ld\n",
                $i,
                *(uint32 *)($r + 24),
                $dur);
        }
    }

    if ($count > 128) {
        printf("  ... +%u more\n", $count - 128);
    }
}

usdt:$1:colagpu:kernel_timing {
    $ptrs = arg0;
    $count = arg1;

    printf("%-12s.%-6u [KERNEL_TIMING] count=%u\n",
           strftime("%H:%M:%S", nsecs),
           (nsecs % 1000000000) / 1000,
           $count);

    // ActivityEvent layout (packed, aligned 8, 72 bytes total):
    //   +0:  kind (u64)
    //   +8:  start (u64)
    //  +16:  end (u64)
    //  +24:  correlationId (u32)
    //  +28:  deviceId (u32)
    //  +32:  streamId (u32)
    //  +36:  tid (u32)                   --- memcpy only: thread ID
    //  +40:  bytes (u64)                 --- memcpy only
    //  +48:  copyKind (u16)              --- memcpy only, vendor-neutral: 100=H2D, 101=D2H/D2D, 103=P2P
    //  +50:  sync (u16)                  --- memcpy only: 1=sync, 0=async
    //  +52:  graphId (u32)               --- kernel only, CUPTI only (0 for MSPTI)
    //  +56:  graphNodeId (u64)           --- kernel only, CUPTI only (0 for MSPTI)
    //  +64:  name (const char *)         --- kernel only: CUPTI buffer / MSPTI k->name
    $limit = $count;
    if ($limit > 128) {
        $limit = 128;
    }
    if ($limit > 0) {
        for ($i : 0..($limit - 1)) {
            $r = *(uint64 *)($ptrs + $i * 8);
            if ($r == 0) { continue; }
            $kind = *(uint64 *)($r);
            $dur = (int64)(*(uint64 *)($r + 16)) - (int64)(*(uint64 *)($r + 8));
            if ($kind == 1) {
                // ACTIVITY_KIND_KERNEL
                $name_ptr = *(uint64 *)($r + 64);
                printf("  [%d] KERNEL  corr=%u dev=%u strm=%u gid=%u node=%lu dur=%ld name=%s\n",
                    $i,
                    *(uint32 *)($r + 24),
                    *(uint32 *)($r + 28),
                    *(uint32 *)($r + 32),
                    *(uint32 *)($r + 52),
                    *(uint64 *)($r + 56),
                    $dur,
                    str($name_ptr));
            } else if ($kind == 3) {
                // ACTIVITY_KIND_MEMCPY
                $copyKind = *(uint16 *)($r + 48);
                $kindStr = ($copyKind == 100) ? "H2D" : (($copyKind == 101) ? "D2H/D2D" : (($copyKind == 103) ? "P2P" : "?"));
                printf("  [%d] MEMCPY  %-7s bytes=%lu  corr=%u dev=%u strm=%u dur=%ld  sync=%u tid=%u\n",
                    $i,
                    $kindStr,
                    *(uint64 *)($r + 40),
                    *(uint32 *)($r + 24),
                    *(uint32 *)($r + 28),
                    *(uint32 *)($r + 32),
                    $dur,
                    *(uint16 *)($r + 50),
                    *(uint32 *)($r + 36));
            } else {
                // Unknown kind — log raw value instead of dropping.
                printf("  [%d] UNKNOWN kind=%lu dur=%ld corr=%u\n",
                    $i,
                    $kind,
                    $dur,
                    *(uint32 *)($r + 24));
            }
        }
    }

    if ($count > 128) {
        printf("  ... +%u more\n", $count - 128);
    }
}

END {
    printf("\nMonitoring complete.\n");
}
