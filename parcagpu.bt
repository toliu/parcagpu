#!/usr/bin/env bpftrace

BEGIN {
    printf("Monitoring CUDA activity via colagpu USDT probes...\n");
    printf("%-20s %-12s %-10s %-10s %-10s %-10s %-10s %-10s %s\n",
           "TIME", "DURATION_NS", "CORR_ID", "DEVICE", "STREAM", "GRAPH", "NODE", "START", "KERNEL");
}

usdt:*:colagpu:api_correlation {
    $correlation_id = arg0;
    $cbid = arg1;
    $name = str(arg2);

    printf("%-12s.%-6u [CORR] %u: cbid=%u %s\n", strftime("%H:%M:%S", nsecs), (nsecs % 1000000000) / 1000, $correlation_id, $cbid, $name);
}

usdt:*:colagpu:api_synchronize {
    $start = arg0;
    $end = arg1;
    $kind = arg2;
    $dur_ns = $end - $start;
    $kindStr = ($kind == 100) ? "cuStreamSynchronize" :
               (($kind == 101) ? "cuCtxSynchronize" :
               (($kind == 102) ? "cuEventSynchronize" :
               (($kind == 103) ? "cuStreamSynchronize_ptsz" : "unknown")));

    printf("%-12s.%-6u [SYNC] kind=%u %s start=%lu end=%lu dur=%lu ns\n",
           strftime("%H:%M:%S", nsecs),
           (nsecs % 1000000000) / 1000,
           $kind, $kindStr, $start, $end, $dur_ns);
}

usdt:*:colagpu:activity_batch {
    $ptrs = arg0;
    $count = arg1;

    printf("%-12s.%-6u [ACT_BATCH] count=%u\n",
           strftime("%H:%M:%S", nsecs),
           (nsecs % 1000000000) / 1000,
           $count);

    $limit = $count;
    if ($limit > 128) {
        $limit = 128;
    }
    // ActivityEvent layout (packed, aligned 8, 72 bytes total):
    //   +0:  kind (u64)
    //   +8:  start (u64)
    //  +16:  end (u64)
    //  +24:  correlationId (u32)
    //  +28:  deviceId (u32)
    //  +32:  streamId (u32)
    //  +36:  tid (u32)                   --- memcpy only: thread ID
    //  +40:  bytes (u64)                 --- memcpy only
    //  +48:  copyKind (u16)              --- memcpy only: 1=H2D, 2=D2H, 8=D2D, 10=P2P
    //  +50:  sync (u16)                  --- memcpy only: 1=sync, 0=async
    //  +52:  graphId (u32)               --- kernel only
    //  +56:  graphNodeId (u64)           --- kernel only
    //  +64:  name (const char *)         --- kernel only: points into CUPTI buffer
    if ($limit > 0) {
        for ($i : 0..($limit)) {
            $r = *(uint64 *)($ptrs + $i * 8);
            if ($r == 0) { continue; }
            $kind = *(uint64 *)($r);
            $dur = (int64)(*(uint64 *)($r + 16)) - (int64)(*(uint64 *)($r + 8));
            if ($kind == 1) {
                // ACTIVITY_KIND_KERNEL
                $name_ptr = *(uint64 *)($r + 64);
                printf("  [%d] KERNEL  corr=%u dev=%u strm=%u gid=%u node=%lu dur=%ld name=%s\n",
                    $i,
                    *(uint32 *)($r + 24),
                    *(uint32 *)($r + 28),
                    *(uint32 *)($r + 32),
                    *(uint32 *)($r + 52),
                    *(uint64 *)($r + 56),
                    $dur,
                    str($name_ptr));
            } else if ($kind == 3) {
                // ACTIVITY_KIND_MEMCPY
                $copyKind = *(uint16 *)($r + 48);
                $kindStr = ($copyKind == 1) ? "H2D" : (($copyKind == 2) ? "D2H" : (($copyKind == 8) ? "D2D" : (($copyKind == 10) ? "P2P" : "?")));
                printf("  [%d] MEMCPY  %-4s bytes=%lu  corr=%u dev=%u strm=%u dur=%ld  sync=%u tid=%u\n",
                    $i,
                    $kindStr,
                    *(uint64 *)($r + 40),
                    *(uint32 *)($r + 24),
                    *(uint32 *)($r + 28),
                    *(uint32 *)($r + 32),
                    $dur,
                    *(uint16 *)($r + 50),
                    *(uint32 *)($r + 36));
            } else {
                // ACTIVITY_KIND_HOST_API (=2) or unknown
                printf("  [%d] HOSTAPI corr=%u dur=%ld  kind=%lu\n",
                    $i,
                    *(uint32 *)($r + 24),
                    $dur,
                    $kind);
            }
        }
    }

    if ($count > 128) {
        printf("  ... +%u more\n", $count - 128);
    }
}

END {
    printf("\nMonitoring complete.\n");
}
